# Copy to .env for local development (`cp .env.example .env`). Never commit .env.
# Values match infra/docker-compose.yml defaults and are for local development only.

# development | test | staging | production   (controls security rules, see src/config)
APP_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

DATABASE_URL=postgresql://platform:dev_only_postgres_password@localhost:55432/platform
DATABASE_POOL_MAX=10
# Used by `prisma migrate dev` and `npm run db:drift` only.
SHADOW_DATABASE_URL=postgresql://platform:dev_only_postgres_password@localhost:55432/platform_shadow
# Used by integration tests; the suite resets this database.
TEST_DATABASE_URL=postgresql://platform:dev_only_postgres_password@localhost:55432/platform_test

REDIS_URL=redis://:dev_only_redis_password@localhost:56379/0

STORAGE_ENDPOINT=http://localhost:58333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=platform-documents
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID=dev-access-key
STORAGE_SECRET_ACCESS_KEY=dev-secret-key-not-for-production

# Comma-separated browser origins (the admin web app). Mobile apps do not need CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Number of reverse-proxy hops to trust for client IPs (0 = none).
TRUST_PROXY_HOPS=0
API_DOCS_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# --- Authentication (Phase 3) -------------------------------------------------
# All of these are optional in development/test and REQUIRED (non-development values)
# in staging/production; the API refuses to start otherwise.
#
# Base64 of a PKCS#8 PEM Ed25519 private key. Unset = ephemeral key per process start.
#   node -e "const {generateKeyPairSync}=require('crypto');console.log(Buffer.from(generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'))"
# AUTH_JWT_PRIVATE_KEY=
# AUTH_JWT_KEY_ID=prod-2026-11
# HMAC pepper for codes/tickets/idempotency (base64, >= 32 bytes). Unset = dev pepper.
# HASHING_PEPPER=
# AES-256 keys for encrypted columns: kid:base64(32 bytes)[,kid:base64]. Unset = dev key.
# FIELD_ENCRYPTION_KEYS=
# FIELD_ENCRYPTION_ACTIVE_KEY_ID=
# dev = in-memory inbox, read codes at GET /api/v1/dev/sms/messages?phone=09...
# disabled = SMS features answer 503 (default outside development: no provider integrated).
SMS_PROVIDER=dev
# Optional comma-separated IPs/CIDRs allowed to use staff accounts.
# STAFF_IP_ALLOWLIST=
