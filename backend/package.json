{
  "name": "kiroween-mobility-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Addis Ababa owner/driver vehicle platform API",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "build:watch": "tsc -w -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.api.js",
    "start:dev": "node --env-file-if-exists=.env --enable-source-maps --watch dist/main.api.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "test:coverage:auth": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text-summary --coverage.include='src/common/auth/**' --coverage.include='src/modules/auth/**' --coverage.include='src/modules/me/**' --coverage.include='src/modules/admin/**' --coverage.include='src/common/idempotency/**' --coverage.exclude='**/*.spec.ts' --coverage.thresholds.lines=90",
    "test:coverage:identity": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text-summary --coverage.include='src/modules/identity/**' --coverage.include='src/providers/identity/**' --coverage.exclude='**/*.spec.ts' --coverage.thresholds.lines=90",
    "staff:bootstrap": "node --env-file-if-exists=.env dist/cli/bootstrap-super-admin.js",
    "identity:expire": "node --env-file-if-exists=.env dist/cli/identity-expire.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1170.0",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/throttler": "6.8.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.17",
    "nestjs-pino": "5.3.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.5.1",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
